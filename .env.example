# ---- LLM (free tier). Leave empty to run the deterministic mock.
LLM_PROVIDER=auto              # auto | groq | mock   (auto = groq if GROQ_API_KEY is set)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---- PayPal SANDBOX. Leave empty to run the in-memory PayPal mock.
PAYPAL_MODE=auto               # auto | sandbox | mock (auto = sandbox if both keys are set)
PAYPAL_CLIENT_ID=              # developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=             # optional: only for /api/webhooks/paypal signature verification
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ---- App
PUBLIC_BASE_URL=http://localhost:8000   # PayPal return/cancel URLs point here
DB_PATH=countersign.db
